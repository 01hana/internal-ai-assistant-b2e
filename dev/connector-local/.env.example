# Required. Use this Mac's LAN address; do not use 127.0.0.1.
LOCAL_LAN_IP=192.168.x.x

# These ports are unused by the repository's existing local topology.
LOCAL_CONNECTOR_RUNTIME_HTTPS_PORT=3443
LOCAL_SHINMONE_HTTPS_PORT=3444

# Existing customer-connector-runtime HTTP listener on the Mac host.
CONNECTOR_RUNTIME_HTTP_PORT=3100
