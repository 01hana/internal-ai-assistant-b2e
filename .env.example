NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://assistant:change-me-local-only@postgres:5432/assistant_dev
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=assistant_dev

LLM_PROVIDER=openai
LLM_MODEL=placeholder-model-name
OPENAI_API_KEY=placeholder-openai-api-key

# Gateway-issued internal identity JWT verification (public values only)
INTERNAL_IDENTITY_JWT_ISSUER=https://gateway.example.internal
INTERNAL_IDENTITY_JWT_AUDIENCE=internal-assistant-core
INTERNAL_IDENTITY_JWKS_URI=https://gateway.example.internal/.well-known/jwks.json
# Clock-skew only; maximum permitted value is 300 seconds and does not extend token lifetime.
INTERNAL_IDENTITY_JWT_CLOCK_TOLERANCE_SECONDS=0

# Gateway profile-only runtime configuration. Registered enabled/active RS256
# trust profiles are the only upstream credential-verification authority.
GATEWAY_INTERNAL_JWT_ISSUER=https://gateway.example.internal
GATEWAY_INTERNAL_JWT_AUDIENCE=internal-assistant-core
GATEWAY_PUBLIC_JWKS_URL=https://gateway.example.internal/.well-known/jwks.json
# Platform-level upstream JWT clock tolerance only; integer 0..300 seconds.
GATEWAY_UPSTREAM_JWT_CLOCK_TOLERANCE_SECONDS=0
GATEWAY_INTERNAL_JWT_TTL_SECONDS=300
GATEWAY_BACKEND_BASE_URL=http://localhost:3000
GATEWAY_SIGNING_KEY_REFERENCE=file:.gateway-local-keys/gateway-signing-key.pem
GATEWAY_ALLOWED_ORIGINS=http://localhost:3001
GATEWAY_LOCAL_SIGNING_BOOTSTRAP_ENABLED=false
GATEWAY_PORT=4000

# Optional bootstrap-only migration inputs. These are not runtime verification
# settings and Gateway never falls back to them when no registered profile exists.
# GATEWAY_UPSTREAM_JWT_ISSUER=https://issuer.example.test
# GATEWAY_UPSTREAM_JWT_AUDIENCE=gateway-audience
# GATEWAY_UPSTREAM_JWKS_URI=https://issuer.example.test/.well-known/jwks.json

ENABLE_RUNTIME_DEBUG=false
ENABLE_REDIS=false
ENABLE_SWAGGER_DOCS=false
SWAGGER_PATH=ai-assistant-docs
