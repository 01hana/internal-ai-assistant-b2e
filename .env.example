NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://assistant:change-me-local-only@postgres:5432/assistant_dev
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=assistant_dev

LLM_PROVIDER=openai
LLM_MODEL=placeholder-model-name
OPENAI_API_KEY=placeholder-openai-api-key

# Gateway-issued internal identity JWT verification (public values only)
INTERNAL_IDENTITY_JWT_ISSUER=https://gateway.example.internal
INTERNAL_IDENTITY_JWT_AUDIENCE=internal-assistant-core
INTERNAL_IDENTITY_JWKS_URI=https://gateway.example.internal/.well-known/jwks.json
# Clock-skew only; maximum permitted value is 300 seconds and does not extend token lifetime.
INTERNAL_IDENTITY_JWT_CLOCK_TOLERANCE_SECONDS=0

ENABLE_RUNTIME_DEBUG=false
ENABLE_REDIS=false
ENABLE_SWAGGER_DOCS=false
SWAGGER_PATH=ai-assistant-docs
