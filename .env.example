NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://assistant:change-me-local-only@postgres:5432/assistant_dev
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=assistant_dev

LLM_PROVIDER=openai
LLM_MODEL=placeholder-model-name
OPENAI_API_KEY=placeholder-openai-api-key

ENABLE_RUNTIME_DEBUG=false
ENABLE_REDIS=false
ENABLE_SWAGGER_DOCS=false
SWAGGER_PATH=ai-assistant-docs

# Gateway-signed internal identity JWT verification (RS256/JWKS)
INTERNAL_IDENTITY_JWT_ISSUER=https://gateway.example.internal
INTERNAL_IDENTITY_JWT_AUDIENCE=internal-ai-assistant
INTERNAL_IDENTITY_JWKS_URI=https://gateway.example.internal/.well-known/jwks.json
INTERNAL_IDENTITY_JWT_CLOCK_TOLERANCE_SECONDS=0

# Comma-separated browser origins. Leave empty when Backend is reachable only through Gateway.
CORS_ALLOWED_ORIGINS=

# Gateway: validate the customer-system JWT, then sign a Backend-only JWT.
GATEWAY_PORT=4000
GATEWAY_EXTERNAL_JWT_ISSUER=https://customer-idp.example.com
GATEWAY_EXTERNAL_JWT_AUDIENCE=customer-system-api
GATEWAY_EXTERNAL_JWKS_URI=https://customer-idp.example.com/.well-known/jwks.json
GATEWAY_INTERNAL_JWT_ISSUER=http://gateway:4000
GATEWAY_INTERNAL_JWT_AUDIENCE=internal-ai-assistant
GATEWAY_INTERNAL_JWT_KEY_ID=gateway-key-2026-01
GATEWAY_INTERNAL_JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_RS256_PKCS8_PRIVATE_KEY
GATEWAY_INTERNAL_JWT_TTL_SECONDS=300
GATEWAY_BACKEND_001_BASE_URL=http://app:3000
# client_id or azp -> immutable hostApp mapping. Add one entry per integrated host application.
GATEWAY_CLIENT_REGISTRY_JSON={"customer-admin-web":{"hostApp":"admin"}}
