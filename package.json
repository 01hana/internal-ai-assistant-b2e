{
  "name": "ai-assistant-core",
  "version": "0.1.0",
  "private": true,
  "description": "Internal backend AI assistant core service.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --testMatch '<rootDir>/test/unit/**/*.spec.ts'",
    "test:integration": "jest --config jest.config.ts --testMatch '<rootDir>/test/integration/**/*.spec.ts' --passWithNoTests",
    "test:contract": "jest --config jest.config.ts --testMatch '<rootDir>/test/contract/**/*.spec.ts' --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:eval": "jest --config jest.config.ts --testMatch '<rootDir>/test/eval/**/*.spec.ts' --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node -e \"console.log('Prisma seed baseline is added in Phase 2 (T019).')\"",
    "test:db:init": "node -e \"console.log('Test database initialization is added in Phase 2 (T019).')\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
