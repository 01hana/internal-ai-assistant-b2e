{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@internal-ai-assistant/connector-runtime-contract": ["../../packages/connector-runtime-contract/dist/index.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "integrations/**/*.ts"]
}
