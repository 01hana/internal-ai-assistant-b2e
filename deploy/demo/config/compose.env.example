# Copy outside Git and replace every value with an approved deployment value.
DEMO_IMAGE_TAG=REPLACE_WITH_APPROVED_BUILD_ID
DEMO_POSTGRES_IMAGE=REPLACE_WITH_APPROVED_POSTGRES_16_IMAGE_DIGEST
DEMO_CADDY_IMAGE=REPLACE_WITH_APPROVED_CADDY_IMAGE_DIGEST
# Optional compose.edge.yaml only; set all three Edge variables when that overlay is included.
# DEMO_NGINX_IMAGE=REPLACE_WITH_APPROVED_NGINX_IMAGE_DIGEST
DEMO_CONFIG_DIR=/absolute/path/to/operator-managed/config
DEMO_SECRET_DIR=/absolute/path/to/operator-managed/secrets
DEMO_CAPABILITY_PACK_DIR=/absolute/path/to/approved/active/packs
DEMO_POSTGRES_USER=REPLACE_WITH_DATABASE_USER
DEMO_POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
DEMO_CONNECTOR_TLS_HOST=REPLACE_WITH_CERTIFICATE_DNS_NAME
DEMO_BACKEND_SUBNET=REPLACE_WITH_NONCONFLICTING_PRIVATE_CIDR
DEMO_GATEWAY_HOST_PORT=REPLACE_WITH_APPROVED_UNUSED_LOOPBACK_PORT
DEMO_BRIDGE_HOST_PORT=REPLACE_WITH_APPROVED_UNUSED_LOOPBACK_PORT
# DEMO_BIND_ADDRESS=REPLACE_WITH_IT_APPROVED_BIND_ADDRESS
# DEMO_HTTPS_PORT=REPLACE_WITH_IT_APPROVED_PORT
# 公司主機的反向代理（Nginx UI）跑在 Docker 時，填它所在的網路名稱，例如 agency_default。
# DEMO_COMPANY_PROXY_NETWORK=agency_default
