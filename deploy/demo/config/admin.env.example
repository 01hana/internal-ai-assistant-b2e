# Feature 014 admin back-office API. Store the active copy outside Git with mode 0600.
# Same database as Core (core.env DATABASE_URL).
DATABASE_URL=
# The Customer this deployment serves; must already exist (created by ./deploy.sh provision).
ADMIN_CUSTOMER_ID=
# The admin website origin (scheme + host [+ port], no path), e.g. https://admin.example.com.
# Used for CORS, the Origin check and the links in invitation and reset mail.
ADMIN_WEB_ORIGIN=
# Optional: IANA time zone for splitting statistics into days and weeks (default Asia/Taipei).
# ADMIN_TIME_ZONE=Asia/Taipei
# Mail (SMTP). ADMIN_MAIL_FROM is the sender, e.g. "AI 助理後台 <no-reply@example.com>".
ADMIN_MAIL_FROM=
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=
# true = TLS from the start (usually port 465); false = STARTTLS or plain (usually 587 or 25).
ADMIN_SMTP_SECURE=false
# Leave both empty when the SMTP server does not require authentication.
ADMIN_SMTP_USER=
ADMIN_SMTP_PASSWORD=
